# Stripe API Keys
# Get these from Stripe Dashboard → Developers → API Keys
# https://dashboard.stripe.com/apikeys

# Publishable key (safe to expose on frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Secret key (keep private, server-side only)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Webhook signing secret
# Get from Stripe Dashboard → Developers → Webhooks after creating endpoint
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# Optional: Database connection string (if using)
# DATABASE_URL=

# Optional: Email service credentials (for sending confirmation emails)
# SENDGRID_API_KEY=
# EMAIL_FROM=orders@practicalpsychadvice.com
